# ==========================================================
#  VOICE OF GOD — Variables d'environnement
#  Copie ce fichier en ".env" pour le developpement local.
#  Sur Render, ajoute ces cles dans l'onglet "Environment".
# ==========================================================

# Mot de passe du tableau de bord admin (CHANGE-LE !)
ADMIN_PASSWORD=VOG2026

# Cle secrete de session (mets une longue chaine aleatoire)
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# Base de donnees Postgres (fournie par Render).
# Laisse VIDE en local -> une base SQLite locale (./data/vog.db) est utilisee automatiquement.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# (Local uniquement) dossier de la base SQLite. Defaut: ./data
# DB_DIR=./data

# Port (Render le fournit automatiquement)
# PORT=3000

# Numero WhatsApp du groupe affiche en pied de page (chiffres seulement, indicatif sans +)
CONTACT_WHATSAPP=2250711025713

# Email de contact affiche en pied de page (laisse vide pour masquer)
CONTACT_EMAIL=

# ==========================================================
#  ANALYSE INTELLIGENTE DES MOTIFS (facultatif)
#  Si ANTHROPIC_API_KEY est defini -> analyse par IA (Claude).
#  Sinon -> analyse par regles integree (gratuite, automatique).
#  Cle a creer sur https://console.anthropic.com
# ==========================================================
# ANTHROPIC_API_KEY=sk-ant-...
# Modele utilise pour l'analyse (defaut: claude-opus-4-8 ; option economique: claude-haiku-4-5)
# ANALYSE_MODEL=claude-opus-4-8
